# =============================================================
# AELB 2.0 - Variables de entorno
# Copia este fichero a .env y ajusta los valores
# NUNCA commits el .env real al repositorio
# =============================================================

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=aelb_db
MYSQL_USER=aelb_user
MYSQL_PASSWORD=change_me_pass

# --- Backend ---
DB_HOST=mysql
DB_PORT=3306
DB_NAME=aelb_db
DB_USER=aelb_user
DB_PASSWORD=change_me_pass

# Obligatorio en todos los entornos. Generar, por ejemplo, con:
# openssl rand -base64 48
# No reutilizar esta variable entre desarrollo, staging y producción.
JWT_SECRET=
# Access token de corta duración (15 min por defecto). El refresh token
# rotatorio (JWT_REFRESH_EXPIRATION_MS, 30 días por defecto) es lo que
# mantiene la sesión iniciada sin volver a pedir credenciales.
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=2592000000
# En producción HTTPS debe ser true. En desarrollo HTTP local puede ser false.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Strict

BACKEND_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8080/api
FRONTEND_PORT=3000
