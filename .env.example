# =============================================================
# AELB 2.0 - Variables de entorno
# Copia este fichero a .env y ajusta los valores
# NUNCA commits el .env real al repositorio
# =============================================================

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=aelb_db
MYSQL_USER=aelb_user
MYSQL_PASSWORD=change_me_pass

# --- Backend ---
DB_HOST=mysql
DB_PORT=3306
DB_NAME=aelb_db
DB_USER=aelb_user
DB_PASSWORD=change_me_pass

# Obligatorio en todos los entornos. Generar, por ejemplo, con:
# openssl rand -base64 48
# No reutilizar esta variable entre desarrollo, staging y producción.
JWT_SECRET=
# Access token de corta duración (15 min por defecto). El refresh token
# rotatorio (JWT_REFRESH_EXPIRATION_MS, 30 días por defecto) es lo que
# mantiene la sesión iniciada sin volver a pedir credenciales.
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=2592000000
# En producción HTTPS debe ser true. En desarrollo HTTP local puede ser false.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Strict

BACKEND_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Object storage (local MinIO) ---
STORAGE_BUCKET=aelb-images
STORAGE_REGION=us-east-1
STORAGE_USE_IAM=false
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8080/api
FRONTEND_PORT=3000
# Transactional email (local uses Mailpit at http://localhost:8025)
APP_ENV=local
EMAIL_PROVIDER=smtp
EMAIL_FROM=noreply@localhost.test
EMAIL_FROM_NAME=AELB
EMAIL_WORKER_ENABLED=true
EMAIL_MAX_PER_SECOND=10
EMAIL_WORKER_CONCURRENCY=1
EMAIL_BATCH_SIZE=10
EMAIL_MAX_RETRIES=5
EMAIL_PROCESSING_TIMEOUT_MINUTES=10
EMAIL_SENT_RETENTION_DAYS=30
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_AUTH=false
SMTP_TLS=false
FRONTEND_PUBLIC_URL=http://localhost:3000
PASSWORD_RESET_TOKEN_EXPIRATION_MINUTES=30
PASSWORD_RESET_COOLDOWN_SECONDS=60
PASSWORD_RESET_MAX_PER_HOUR=5
EMAIL_VERIFICATION_TOKEN_EXPIRATION_HOURS=24
EMAIL_VERIFICATION_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_MAX_PER_HOUR=5
EMAIL_TOKEN_ENCRYPTION_KEY=local-only-change-me
AWS_REGION=eu-west-1

# --- Observabilidad ---
# Logs locales legibles; producción debe mantener INFO y recoger stdout en CloudWatch.
LOG_LEVEL_ROOT=INFO
APP_VERSION=local
GIT_COMMIT=unknown
