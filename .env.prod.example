# Usar con: docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
# Sustituir todos los valores sensibles y preferir Secrets Manager/Parameter Store.
APP_VERSION=2026.08.19
GIT_COMMIT=replace-with-image-commit
LOG_LEVEL_ROOT=INFO

DB_HOST=managed-mysql.internal
DB_PORT=3306
DB_NAME=aelb_db
DB_USER=aelb_app
DB_PASSWORD=replace-with-secret-manager-value
JWT_SECRET=replace-with-at-least-32-random-bytes
AUTH_COOKIE_SAME_SITE=Strict
CORS_ALLOWED_ORIGINS=https://app.example.com

STORAGE_BUCKET=aelb-production
STORAGE_REGION=eu-south-2
STORAGE_PUBLIC_ENDPOINT=https://app.example.com

STRIPE_SECRET_KEY=replace-with-stripe-live-secret
STRIPE_WEBHOOK_SECRET=replace-with-stripe-live-webhook-secret
STRIPE_SUCCESS_URL=https://app.example.com/perfil?stripe=success&session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=https://app.example.com/perfil?stripe=cancelled

EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=AELB
AWS_REGION=eu-south-2
FRONTEND_PUBLIC_URL=https://app.example.com
EMAIL_TOKEN_ENCRYPTION_KEY=replace-with-random-secret
NEXT_PUBLIC_API_URL=https://api.example.com
FRONTEND_PORT=3000
